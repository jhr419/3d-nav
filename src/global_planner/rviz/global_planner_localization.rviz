Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: ICP Visualization Map
      Topic: /icp_visualization_map
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: ICP Aligned Cloud
      Topic: /icp_aligned_cloud
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic: /octomap_occupied_markers
      Name: OctoMap Occupied
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic: /global_path_marker
      Name: Global Path Marker
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Path 3D
      Topic: /global_path_3d
  Enabled: true
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
