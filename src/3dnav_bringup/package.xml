<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav3d_bringup</name>
  <version>0.1.0</version>
  <description>Unified launch and configuration package for the 3D navigation stack.</description>
  <maintainer email="jhr@example.com">jhr</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav3d_control</exec_depend>
  <exec_depend>ego_local_planner</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>localization_adapter</exec_depend>
  <exec_depend>mapping_adapter</exec_depend>
  <exec_depend>jie_octomap</exec_depend>
  <exec_depend>octo_planner</exec_depend>
  <exec_depend>pct_global_planner</exec_depend>
  <exec_depend>pct_planner_ros2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>go2_twist_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
